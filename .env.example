NEXT_PUBLIC_API_URL=https://api-staging-eth-l2.magro.dev
NEXT_PUBLIC_ETH_TX_API_URL=https://api-staging-eth-tx.magro.dev

# Optional: Vercel CLI / API auth for local deploys or agent tooling.
# Real token lives in 1Password — copy into a local .env (gitignored), never commit it.
# VERCEL_TOKEN=

# FRED API key for official Treasury constant-maturity yields in the homepage 3D intro.
# Store in 1Password. Never commit. Never use NEXT_PUBLIC_.
# Without this key the intro still uses prior-close levels from Treasury.gov + Coinbase daily candles.
# FRED_API_KEY=
#
# Inject locally (requires 1Password CLI app integration):
#   npm run inject:intro-secrets
# Or with a custom item path:
#   FRED_API_KEY_OP_REF='op://Vault/Item/credential' npm run inject:intro-secrets
#
# Also set FRED_API_KEY in the Vercel project environment for production.
